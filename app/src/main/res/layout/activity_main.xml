<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:padding="14dp"
        android:text="灵动豹豹"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 卡片导航：简易模式 / Lua脚本 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cardSimple"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:text="简易模式\n不写代码，点哪打哪\n点击新建 ＋"
                    android:textColor="@color/text_on_card"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/cardLua"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:text="Lua 脚本\n进阶玩家，代码自由\n点击新建 ＋"
                    android:textColor="@color/text_on_card"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 第二行：教程 / 悬浮控制台 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cardTutorial"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_alt"
                    android:padding="14dp"
                    android:text="教程说明\n快速上手三步走"
                    android:textColor="@color/text_on_card"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/cardConsole"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_alt"
                    android:padding="14dp"
                    android:text="悬浮控制台\n到目标APP上点哪打哪"
                    android:textColor="@color/text_on_card"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvListHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="任务列表"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="还没有任务。点上方卡片新建一个吧～"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
